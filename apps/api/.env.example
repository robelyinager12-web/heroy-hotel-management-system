# Server
NODE_ENV=production
PORT=4000
CLIENT_URL=https://your-domain.com

# Database (use your hosted Postgres connection string in production)
DATABASE_URL="postgresql://user:password@host:5432/heroy_hotel_db?schema=public"

# Auth — generate long random values for production, never reuse dev secrets
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# AI Services
AI_PROVIDER_API_KEY=
AI_VOICE_PROVIDER_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@heroyhotel.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100