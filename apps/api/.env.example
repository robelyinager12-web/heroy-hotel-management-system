# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/heroy_hotel?schema=public"

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_too
REFRESH_TOKEN_EXPIRES_IN=30d

# AI Services
AI_PROVIDER_API_KEY=
AI_VOICE_PROVIDER_API_KEY=

# Email (for AI report delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@heroyhotel.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100